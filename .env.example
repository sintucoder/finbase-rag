# Copy this file to ".env" and fill in your values. ".env" is git-ignored, never commit your key.

# ---------- LLM (required) ----------
# Any provider with an OpenAI-compatible API works. Only these three values change.
LLM_API_KEY=paste-your-api-key-here

# Leave LLM_BASE_URL empty to use OpenAI. For Google Gemini (has a free tier) use:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# For other providers (Groq, OpenRouter, a local Ollama ...) look up their OpenAI-compatible base URL.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Use a current model id from your provider's model list. Ids change over time,
# so check the provider's documentation. "gemini-2.5-flash" is only an example.
LLM_MODEL=gemini-2.5-flash

# ---------- optional: retrieval settings (defaults shown) ----------
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# TOP_K=5
# MIN_SIMILARITY=0.30     # calibrate with: python evaluate.py --retrieval-only
# CHUNK_SIZE=750
# CHUNK_OVERLAP=100
# HISTORY_TURNS=3
# LLM_MAX_TOKENS=1024

# If you switch to a BGE embedding model, e.g. BAAI/bge-small-en-v1.5, its similarity scores
# are higher than MiniLM's, so raise MIN_SIMILARITY (try 0.5 and calibrate again).
